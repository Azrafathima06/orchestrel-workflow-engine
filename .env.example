# Copy this file to .env for local development:
#   cp .env.example .env
#
# These are LOCAL DEVELOPMENT defaults only. Never put real Neon, Render,
# or GitHub credentials in this file or any committed file. Production
# values are set in the Render dashboard (see docs/deployment.md).

# --- Application identity ---
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Infrastructure ---
# Points at the Compose service name, not localhost, so the API container
# can resolve it. Credentials here are local-only development defaults.
#
# In production DATABASE_URL is the Neon POOLED connection (-pooler host).
# A bare postgresql:// or legacy postgres:// scheme is normalized to
# postgresql+psycopg:// automatically, preserving credentials, port, and
# query parameters such as sslmode=require.
DATABASE_URL=postgresql+psycopg://workflow:workflow@postgres:5432/workflow_engine

# Optional. In production this is the Neon DIRECT (unpooled) connection,
# used for Alembic migrations and workflow seeding, per Neon's guidance
# that DDL should not go through the transaction-mode pooler. Leave empty
# locally: there is only one endpoint, so it falls back to DATABASE_URL.
DATABASE_DIRECT_URL=

# In production this is the Render Key Value INTERNAL url. Both redis://
# and rediss:// are supported.
BROKER_URL=redis://redis:6379/0

# Comma-separated exact origins. Production must list only the real static
# site origin — the app refuses to start on "*" when APP_ENV=production.
CORS_ORIGINS=http://localhost:5173

# --- Local Postgres container settings (used by docker-compose.yml) ---
POSTGRES_DB=workflow_engine
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow

# --- Public-demo protection (unauthenticated deployment) ---
# Per-client workflow triggers allowed per minute.
PUBLIC_TRIGGER_RATE_PER_MINUTE=10
# Concurrent PENDING/RUNNING runs allowed across the whole deployment.
MAX_ACTIVE_RUNS=10
# Largest accepted request body, in bytes.
MAX_REQUEST_BODY_BYTES=16384

# --- Reliability / recovery knobs ---
# Sensible defaults for local development; production values may differ.
QUEUED_STALE_SECONDS=120
LEASE_GRACE_SECONDS=60
RETRY_RELEASE_GRACE_SECONDS=30
RUN_STALL_SECONDS=300
MAX_DISPATCH_ATTEMPTS=5
SWEEP_BATCH=100
SCHEDULER_TICK_SECONDS=30
BROKER_VISIBILITY_TIMEOUT=7200

# Copy this file to .env for local development:
#   cp .env.example .env
#
# These are LOCAL DEVELOPMENT defaults only. Never put real Neon, Render,
# Upstash, or GitHub credentials in this file or any committed file.

# --- Application identity ---
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Infrastructure ---
# Points at the Compose service name, not localhost, so the API container
# can resolve it. Credentials here are local-only development defaults.
DATABASE_URL=postgresql+psycopg://workflow:workflow@postgres:5432/workflow_engine
BROKER_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173

# --- Local Postgres container settings (used by docker-compose.yml) ---
POSTGRES_DB=workflow_engine
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow

# --- Reliability / recovery knobs (see docs/reliability.md) ---
# Sensible defaults for local development; production values may differ.
QUEUED_STALE_SECONDS=120
LEASE_GRACE_SECONDS=60
RETRY_RELEASE_GRACE_SECONDS=30
RUN_STALL_SECONDS=300
MAX_DISPATCH_ATTEMPTS=5
SWEEP_BATCH=100
SCHEDULER_TICK_SECONDS=30
BROKER_VISIBILITY_TIMEOUT=7200
